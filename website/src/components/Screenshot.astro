---
// Shows a screenshot from src/assets/screens/ if the file exists at build time, as WebP in the sizes
// the page needs. Until then it shows a neutral frame with the logo, so there is never a broken image.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  /** File name in src/assets/screens/, for example "warning.png". */
  src: string;
  alt: string;
  label: string;
  /** The widest the picture is shown, in CSS pixels. */
  width?: number;
  /** Width and height of the neutral frame while the file is missing. */
  frame?: [number, number];
}

const { src, alt, label, width = 800, frame = [1600, 1000] } = Astro.props;
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/screens/*.{png,jpg}', { eager: true });
const image = files[`../assets/screens/${src.replace(/^.*\//, '')}`]?.default;
---

<figure class="shot">
  {
    image ? (
      <Image src={image} alt={alt} width={Math.min(width * 2, image.width)} widths={[width, Math.min(width * 2, image.width)]} sizes={`(max-width: ${width}px) 100vw, ${width}px`} format="webp" loading="lazy" decoding="async" />
    ) : (
      <div class="shot-empty" style={`aspect-ratio:${frame[0]}/${frame[1]}`} role="img" aria-label={`${label} (screenshot to be added)`}>
        <img src="/openwren-logo.svg" alt="" width="56" height="56" />
        <span>{label}</span>
      </div>
    )
  }
</figure>

<style>
  .shot {
    margin: 0;
  }
  .shot img,
  .shot-empty {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--border);
    border-radius: 12px;
  }
  .shot-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    background: var(--tint);
    color: var(--text-2);
    font-size: 0.9rem;
  }
  .shot-empty img {
    width: 56px;
    height: 56px;
    border: 0;
    border-radius: 13px;
  }
</style>
